# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key（sb_publishable_...）；舊專案可用 anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key（sb_secret_...）；舊專案可用 service_role key。只放在伺服器，絕對不要加 NEXT_PUBLIC_ 前綴
SUPABASE_SECRET_KEY=

# 建議設定：帳號密碼註冊時，內部使用的假 email 網域（不會寄信）。
# 換成別人猜不到的字串，可以避免有人用公開 API 先搶註某個帳號名稱。上線後就不要再改。
# USERNAME_EMAIL_DOMAIN=users-隨機字串.invalid
